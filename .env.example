# with full English & Urdu everyday guidance + safety escalation logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or Google Gemini API key:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
